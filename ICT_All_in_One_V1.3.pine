//Daylight Saving Time
DST_Detector(Start_Month, Start_Day, Start_CountDay, End_Month, End_Day, End_CountDay, TimeZone) =>
    var int StartCountDay = 0
    var int EndCountDay   = 0
    var bool S_PermitCount = true
    var bool E_PermitCount = true
    var bool SS_PermitCount = true
    var bool EE_PermitCount = true
    var int S = Start_CountDay
    var int E = End_CountDay   
    Y = year
    M = month
    D = dayofweek
    //dayofmonth counter
    if M[1] != M
        StartCountDay := 0
        EndCountDay   := 0
        SS_PermitCount := true
        EE_PermitCount := true       
    if D[1] != D
        S_PermitCount := true
        E_PermitCount := true

    if D == Start_Day and S_PermitCount
        StartCountDay  := StartCountDay + 1
        S_PermitCount := false

    if D == End_Day and E_PermitCount
        EndCountDay    := EndCountDay + 1
        E_PermitCount := false
    if Start_CountDay < 4 and SS_PermitCount == true
        S := Start_CountDay
    else if Start_CountDay == 4 and SS_PermitCount == true
        if StartCountDay < 4
            S := 4
        else if (StartCountDay[1] == 3 and StartCountDay == 4) and dayofmonth > 23
            S := 4
            SS_PermitCount := false
        else 
            S := 5
    
    if End_CountDay < 4 and EE_PermitCount == true
        E := End_CountDay
    else if End_CountDay == 4 and EE_PermitCount == true
        if EndCountDay < 4
            E := 4
        else if (EndCountDay[1] == 3 and EndCountDay == 4) and dayofmonth > 23
            E := 4
            EE_PermitCount := false
        else 
            E := 5

    if  M == Start_Month and StartCountDay >= S
     or  (M > Start_Month and M < End_Month)
     or M == End_Month and  EndCountDay < E 
        TimeZone == "Australia/Sydney" ? 'Inactive' : 'Active'
    else 
        TimeZone == "Australia/Sydney" ? 'Active' : 'Inactive'
    
London_DST  = DST_Detector(3 , dayofweek.sunday, 4, 10 , dayofweek.sunday, 4,    "Europe/London")
NewYork_DST = DST_Detector(3 , dayofweek.sunday, 2, 11 , dayofweek.sunday, 1, "America/New_York")

//Session Timing
Market_TimeZone_Calculator(TimeZoneMode) =>
    var string London_Macro_1     = na
    var string London_Macro_2     = na
    var string New_York_AM_1      = na
    var string New_York_AM_2      = na
    var string New_York_AM_3      = na
    var string New_York_Lunch     = na
    var string New_York_PM        = na
    var string New_York_Last_Hour = na
    
    if TimeZoneMode == 'UTC'

        if London_DST == 'Inactive'
            London_Macro_1   := '0733-0800'
            London_Macro_2   := '0903-0930'

        else if London_DST == 'Active'
            London_Macro_1   := '0633-0700'
            London_Macro_2   := '0803-0830'


        if NewYork_DST == 'Inactive'
            New_York_AM_1      := '1350-1410'
            New_York_AM_2      := '1450-1510'
            New_York_AM_3      := '1550-1610'
            New_York_Lunch     := '1650-1710'
            New_York_PM        := '1810-1840'
            New_York_Last_Hour := '2015-2045'
        else if NewYork_DST == 'Active'
            New_York_AM_1      := '1250-1310'
            New_York_AM_2      := '1350-1410'
            New_York_AM_3      := '1450-1510'
            New_York_Lunch     := '1550-1610'
            New_York_PM        := '1710-1740'
            New_York_Last_Hour := '1950-2000'


    else if TimeZoneMode == 'Session Local Time'  or TimeZoneMode == 'Your Time Zone'

        if London_DST == 'Inactive'
            London_Macro_1   := '0333-0400'
            London_Macro_2   := '0503-0530'

        else if London_DST == 'Active'
            London_Macro_1   := '0233-0300'
            London_Macro_2   := '0403-0430'


        if NewYork_DST == 'Inactive'
            New_York_AM_1      := '0850-0910'
            New_York_AM_2      := '0950-1010'
            New_York_AM_3      := '1050-1110'
            New_York_Lunch     := '1150-1210'
            New_York_PM        := '1310-1340'
            New_York_Last_Hour := '1515-1545'
        else if NewYork_DST == 'Active'
            New_York_AM_1      := '0850-0910'
            New_York_AM_2      := '0950-1010'
            New_York_AM_3      := '1050-1110'
            New_York_Lunch     := '1150-1210'
            New_York_PM        := '1310-1340'
            New_York_Last_Hour := '1550-1600'

    [London_Macro_1, London_Macro_2, New_York_AM_1, New_York_AM_2, New_York_AM_3, New_York_Lunch, New_York_PM, New_York_Last_Hour]

//zones

[London_Macro_1, London_Macro_2, New_York_AM_1, New_York_AM_2, New_York_AM_3, New_York_Lunch, New_York_PM, New_York_Last_Hour] = Market_TimeZone_Calculator(TimeZoneMode)


London_Macro_1_TZ     = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
London_Macro_2_TZ     = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
New_York_AM_1_TZ      = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
New_York_AM_2_TZ      = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
New_York_AM_3_TZ      = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
New_York_Lunch_TZ     = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
New_York_PM_TZ        = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na
New_York_Last_Hour_TZ = TimeZoneMode == 'Session Local Time' or TimeZoneMode == 'Your Time Zone'?  "America/New_York" : TimeZoneMode == 'UTC' ? 'UTC+0' :  na


On_London_Macro_1     = math.sign(nz(time(timeframe.period, London_Macro_1, London_Macro_1_TZ)))
On_London_Macro_2     = math.sign(nz(time(timeframe.period, London_Macro_2, London_Macro_2_TZ)))
On_New_York_AM_1      = math.sign(nz(time(timeframe.period, New_York_AM_1, New_York_AM_1_TZ)))
On_New_York_AM_2      = math.sign(nz(time(timeframe.period, New_York_AM_2, New_York_AM_2_TZ)))
On_New_York_AM_3      = math.sign(nz(time(timeframe.period, New_York_AM_3, New_York_AM_3_TZ)))
On_New_York_Lunch     = math.sign(nz(time(timeframe.period, New_York_Lunch, New_York_Lunch_TZ)))
On_New_York_PM        = math.sign(nz(time(timeframe.period, New_York_PM, New_York_PM_TZ)))
On_New_York_Last_Hour = math.sign(nz(time(timeframe.period, New_York_Last_Hour, New_York_Last_Hour_TZ)))

//High & Low Session Detector 

LowHighSessionDetector(On, Front_On ,Color, Text) =>
    var int Bar = 0
    var float High = 0.0 
    var float Low = 0.0
    var box BoX = na
    var line H_Line = na
    var line L_Line = na
    var label LabeL = na 
    var bool Permit = false
    if  (On[1] == 0 and On == 1)
        Bar := bar_index
        High := high
        Low := low
        
    else 
        if On[1] == 1 or On == 1
            High := math.max(high , High) 
            Low :=   math.min(low , Low)

    if On > On[1] and str.tonumber(timeframe.period) <= 16
        BoX := box.new(bar_index,High, bar_index , Low, bgcolor = color.new(Color, 85),
         border_color = color.rgb(34, 101, 155),
         border_style = line.style_dotted)
        
        LabeL := label.new(int(math.avg(Bar,bar_index)), High , text = Text ,xloc = xloc.bar_index, yloc = yloc.price, size = size.normal ,
         style =  label.style_label_down  , textcolor = color.rgb(34, 101, 155), color = color.rgb(255, 255, 255, 100))
    if On[1] == 1 or On == 1
        box.set_top(BoX, High)
        box.set_bottom(BoX, Low)
        box.set_right(BoX, bar_index)
        label.set_x(LabeL,math.round(math.avg(Bar,bar_index)))
        label.set_y(LabeL, High)
    
    if On < On[1]
        H_Line := line.new(bar_index, High, bar_index + 1, High, color = Color , style = line.style_dashed)
        L_Line := line.new(bar_index, Low , bar_index + 1, Low , color = Color , style = line.style_dashed)
        Permit := true
    if not (Front_On[1] < Front_On) and Permit
        H_Line.set_x2(bar_index)
        L_Line.set_x2(bar_index)
    if Front_On == 1
        Permit := false 
    [High , Low ]
  

// Start and Enf Time
SplitFunction(x, TZ ,YourTZ) =>
    Text  = str.split(x, '-')
    STime = Text.size() > 0 ? (Text.get(0)) : '0000'
    ETime = Text.size() > 0 ? (Text.get(1)) : '0000'
    SHour = str.substring(STime ,0,2)
    SMin  = str.substring(STime ,2,4)
    EHour = str.substring(ETime ,0,2)
    EMin  = str.substring(ETime ,2,4)
    SUTCTimestamp = timestamp(TZ, year, month, dayofmonth, int(str.tonumber(SHour)), int(str.tonumber(SMin)), 0)
    EUTCTimestamp = timestamp(TZ, year, month, dayofmonth, int(str.tonumber(EHour)), int(str.tonumber(EMin)), 0)
    SconvertedHour = hour(SUTCTimestamp, YourTZ)
    SconvertedMinute = minute(SUTCTimestamp, YourTZ)
    EconvertedHour = hour(EUTCTimestamp, YourTZ)
    EconvertedMinute = minute(EUTCTimestamp, YourTZ)
    YourStart = str.tostring(SconvertedHour) + ':' + str.tostring(SconvertedMinute < 10 ? '0' + 
     str.tostring(SconvertedMinute) : str.tostring(SconvertedMinute))
    YourEnd = str.tostring(EconvertedHour) + ':' + str.tostring(EconvertedMinute < 10 ? '0' + 
     str.tostring(EconvertedMinute) : str.tostring(EconvertedMinute))

    Start = TimeZoneMode == 'Your Time Zone'  ? YourStart  : (SHour + ':' + SMin)
    End   = TimeZoneMode == 'Your Time Zone'  ? YourEnd : (EHour + ':' + EMin)
    [Start, End]

[London_Macro_1_Start, London_Macro_1_End]         = SplitFunction(London_Macro_1, London_Macro_1_TZ, YourTZ)
[London_Macro_2_Start, London_Macro_2_End]         = SplitFunction(London_Macro_2, London_Macro_2_TZ, YourTZ)
[New_York_AM_1_Start, New_York_AM_1_End]           = SplitFunction(New_York_AM_1, New_York_AM_1_TZ, YourTZ)
[New_York_AM_2_Start, New_York_AM_2_End]           = SplitFunction(New_York_AM_2, New_York_AM_2_TZ, YourTZ)
[New_York_AM_3_Start, New_York_AM_3_End]           = SplitFunction(New_York_AM_3, New_York_AM_3_TZ, YourTZ)
[New_York_Lunch_Start, New_York_Lunch_End]         = SplitFunction(New_York_Lunch, New_York_Lunch_TZ, YourTZ)
[New_York_PM_Start, New_York_PM_End]               = SplitFunction(New_York_PM, New_York_PM_TZ, YourTZ)
[New_York_Last_Hour_Start, New_York_Last_Hour_End] = SplitFunction(New_York_Last_Hour, New_York_Last_Hour_TZ, YourTZ)

//Text 
TZ = TimeZoneMode == 'Session Local Time' ? 'New York' : TimeZoneMode == 'Your Time Zone' ? YourTZ : 'UTC'
London_Macro_1_text     = 'LDN 1'           + (Show_Time ? ('\n' + London_Macro_1_Start     + ' ' + 'to' + ' ' + London_Macro_1_End     + ' ' + '(' + TZ + ')') : '')
London_Macro_2_text     = 'LDN 2'           + (Show_Time ? ('\n' + London_Macro_2_Start     + ' ' + 'to' + ' ' + London_Macro_2_End     + ' ' + '(' + TZ + ')') : '')
New_York_AM_1_text      = 'NY AM 1'         + (Show_Time ? ('\n' + New_York_AM_1_Start      + ' ' + 'to' + ' ' + New_York_AM_1_End      + ' ' + '(' + TZ + ')') : '')
New_York_AM_2_text      = 'NY AM 2'         + (Show_Time ? ('\n' + New_York_AM_2_Start      + ' ' + 'to' + ' ' + New_York_AM_2_End      + ' ' + '(' + TZ + ')') : '')
New_York_AM_3_text      = 'NY AM 3'         + (Show_Time ? ('\n' + New_York_AM_3_Start      + ' ' + 'to' + ' ' + New_York_AM_3_End      + ' ' + '(' + TZ + ')') : '')
New_York_Lunch_text     = 'NY Lunch'        + (Show_Time ? ('\n' + New_York_Lunch_Start     + ' ' + 'to' + ' ' + New_York_Lunch_End     + ' ' + '(' + TZ + ')') : '')
New_York_PM_text        = 'NY PM'           + (Show_Time ? ('\n' + New_York_PM_Start        + ' ' + 'to' + ' ' + New_York_PM_End        + ' ' + '(' + TZ + ')') : '')
New_York_Last_Hour_text = 'NY Last Hour'    + (Show_Time ? ('\n' + New_York_Last_Hour_Start + ' ' + 'to' + ' ' + New_York_Last_Hour_End + ' ' + '(' + TZ + ')') : '')


if show_London_Macro_1
