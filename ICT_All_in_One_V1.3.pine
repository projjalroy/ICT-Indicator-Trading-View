//------------------------------ Plotting ------------------------------
var pricearray = array.new_float(0)
var labelarray = array.new_label(0)
f_LevelMerge(pricearray, labelarray, currentprice, currentlabel, currentcolor) =>
    if mergebool and array.includes(pricearray, currentprice)
        whichindex = array.indexof(pricearray, currentprice)
        labelhold = array.get(labelarray, whichindex)
        whichtext = label.get_text(labelhold)

        label.set_text(labelhold, label.get_text(currentlabel) + ' / ' + whichtext)
        label.set_text(currentlabel, '')
        label.set_textcolor(labelhold, currentcolor)
    else if mergebool
        array.push(pricearray, currentprice)
        array.push(labelarray, currentlabel)


var can_show_daily = is_daily_enabled and timeframe.isintraday
var can_show_weekly = is_weekly_enabled and not timeframe.isweekly and not timeframe.ismonthly
var can_show_monthly = is_monthly_enabled and not timeframe.ismonthly

type Lvl
    bool on
    int t
    float p
    string txt
    color col

var array<line> lvlLines = array.new<line>(40)
var array<label> lvlLabels = array.new<label>(40)

get_limit_right(bars) =>
    timenow + (time - time[1]) * bars

// the following code doesn't need to be processed on every candle
if barstate.islast
    pricearray := array.new_float(0)
    labelarray := array.new_label(0)
    levels = array.new<Lvl>()
    levels.push(Lvl.new(is_londonrange_enabled, londontime, flondonhigh, lhtext, LondonColor))
    levels.push(Lvl.new(is_londonrange_enabled, londontime, flondonlow, lltext, LondonColor))
    levels.push(Lvl.new(is_londonrange_enabled, londontime, flondonopen, lotext, LondonColor))
    levels.push(Lvl.new(is_usrange_enabled, ustime, fushigh, ushtext, USColor))
    levels.push(Lvl.new(is_usrange_enabled, ustime, fuslow, usltext, USColor))
    levels.push(Lvl.new(is_usrange_enabled, ustime, fusopen, usotext, USColor))
    levels.push(Lvl.new(is_asiarange_enabled, asiatime, fasiahigh, asiahtext, AsiaColor))
    levels.push(Lvl.new(is_asiarange_enabled, asiatime, fasialow, asialtext, AsiaColor))
    levels.push(Lvl.new(is_asiarange_enabled, asiatime, fasiaopen, asiaotext, AsiaColor))
    levels.push(Lvl.new(is_intra_enabled, intra_time, intra_open, iotext, IntraColor))
    levels.push(Lvl.new(is_intrarange_enabled, intrah_time, intrah_open, pihtext, IntraColor))
    levels.push(Lvl.new(is_intrarange_enabled, intral_time, intral_open, piltext, IntraColor))
    levels.push(Lvl.new(is_intram_enabled, intrah_time, (intral_open + intrah_open) / 2, pimtext, IntraColor))
    levels.push(Lvl.new(is_monday_enabled, monday_time, monday_high, pmonhtext, MondayColor))
    levels.push(Lvl.new(is_monday_enabled, monday_time, monday_low, pmonltext, MondayColor))
    levels.push(Lvl.new(is_monday_mid, monday_time, (monday_high + monday_low) / 2, pmonmtext, MondayColor))
    levels.push(Lvl.new(is_daily_enabled, daily_time, daily_open, dotext, DailyColor))
    levels.push(Lvl.new(is_dailyrange_enabled, dailyh_time, dailyh_open, pdhtext, DailyColor))
    levels.push(Lvl.new(is_dailyrange_enabled, dailyl_time, dailyl_open, pdltext, DailyColor))
    levels.push(Lvl.new(is_dailym_enabled, dailyh_time, (dailyl_open + dailyh_open) / 2, pdmtext, DailyColor))
    levels.push(Lvl.new(is_weekly_enabled, weekly_time, weekly_open, wotext, WeeklyColor))
    levels.push(Lvl.new(is_weeklyrange_enabled, weeklyh_time, weeklyh_open, pwhtext, WeeklyColor))
    levels.push(Lvl.new(is_weeklyrange_enabled, weeklyl_time, weeklyl_open, pwltext, WeeklyColor))
    levels.push(Lvl.new(is_weekly_mid, weeklyh_time, (weeklyl_open + weeklyh_open) / 2, pwmtext, WeeklyColor))
    levels.push(Lvl.new(is_yearlyrange_enabled, yearlyl_time, yearlyl_open, cyltext, YearlyColor))
    levels.push(Lvl.new(is_yearlyrange_enabled, yearlyh_time, yearlyh_open, cyhtext, YearlyColor))
    levels.push(Lvl.new(is_yearly_enabled, yearly_time, yearly_open, yotext, YearlyColor))
    levels.push(Lvl.new(is_yearly_mid, yearlyh_time, (yearlyl_open + yearlyh_open) / 2, cymtext, YearlyColor))
    levels.push(Lvl.new(is_quarterly_enabled, quarterly_time, quarterly_open, qotext, quarterlyColor))
    levels.push(Lvl.new(is_quarterlyrange_enabled, quarterlyh_time, quarterlyh_open, pqhtext, quarterlyColor))
    levels.push(Lvl.new(is_quarterlyrange_enabled, quarterlyl_time, quarterlyl_open, pqltext, quarterlyColor))
    levels.push(Lvl.new(is_quarterly_mid, quarterlyh_time, (quarterlyl_open + quarterlyh_open) / 2, pqmtext, quarterlyColor))
    levels.push(Lvl.new(is_monthlyrange_enabled, monthlyl_time, monthlyl_open, pmltext, MonthlyColor))
    levels.push(Lvl.new(is_monthlyrange_enabled, monthlyl_time, monthlyh_open, pmhtext, MonthlyColor))
    levels.push(Lvl.new(is_monthly_mid, monthlyh_time, (monthlyl_open + monthlyh_open) / 2, pmmtext, MonthlyColor))
    levels.push(Lvl.new(is_monthly_enabled, monthly_time, monthly_open, motext, MonthlyColor))

    limitRight = get_limit_right(DEFAULT_EXTEND_RIGHT)
    for i = 0 to levels.size() - 1
        Lvl lv = levels.get(i)
        if lv.on
            int x1 = displayStyle == 'Right Anchored' ? get_limit_right(radistance) : lv.t
            line ln = lvlLines.get(i)
            label lb = lvlLabels.get(i)
            if na(ln)
                ln := line.new(x1, lv.p, limitRight, lv.p, xloc = xloc.bar_time, color = lv.col, width = DEFAULT_LINE_WIDTH, style = linestyles)
                lb := label.new(limitRight, lv.p, lv.txt, xloc = xloc.bar_time, style = DEFAULT_LABEL_STYLE, textcolor = lv.col, size = DEFAULT_LABEL_SIZE)
                lvlLines.set(i, ln)
                lvlLabels.set(i, lb)
            else
                line.set_xy1(ln, x1, lv.p)
                line.set_xy2(ln, limitRight, lv.p)
                label.set_xy(lb, limitRight, lv.p)
                label.set_text(lb, lv.txt)
            f_LevelMerge(pricearray, labelarray, lv.p, lb, lv.col)

    // the start of the monthly-open line is drawn from the first week of the month; if the first
    // weekly candle (monday) is the 2nd of the month we fix the start on the previous weekly candle
    if is_monthly_enabled and timeframe.isweekly and dayofweek(monthly_time) != dayofweek.monday
        line.set_x1(lvlLines.get(35), monthly_time - (weekly_time - weekly_time[1]))

var inputHighlightIntermediates = input(true, 'Highlight Intermediate Swing Highs and Lows')
var inputIntermediateSize = input.string('Tiny', 'Intermediate Swing Label Size', options=['Auto', 'Tiny', 'Small', 'Normal'])
var inputShowShortTermSwings = input(false, 'Short Term Swings')
var inputPivotBars = input(2, 'Pivot Candles')
var highcolor = input.color(color.red, title="High", tooltip="select a color for ST/IT Highs")
var lowcolor = input.color(color.green, title="Low", tooltip="select a color for ST/IT Lows")

var intermediateLabelSize = inputIntermediateSize == 'Auto' ? size.auto : inputIntermediateSize == 'Tiny' ? size.tiny : inputIntermediateSize == 'Small' ? size.small : size.normal

// Parallel arrays for Swing High Data
var float[] swingHighs = array.new_float()
var label[] swingHighLabels = array.new_label()
var bool[] swingHighIsHigher = array.new_bool()
var bool[] swingHighIsIntermediate = array.new_bool()

// Parallel arrays for Swing Low Data
var float[] swingLows = array.new_float()
var label[] swingLowLabels = array.new_label()
var bool[] swingLowIsLower = array.new_bool()
var bool[] swingLowIsIntermediate = array.new_bool()

// see last element pushed an an array
array_peek(arrayId) =>
    int arraySize = array.size(arrayId)
    if arraySize > 0
        array.get(arrayId, arraySize - 1)
    else
        na

// filters out swings that were not intermediate swings after all swings have been recorded.
remove_short_term_swings() =>
    if not inputShowShortTermSwings and barstate.islast
        var swingHighCount = array.size(swingHighLabels)
        var swingLowCount = array.size(swingLowLabels)

        for i = 0 to swingHighCount - 1 by 1
            if not array.get(swingHighIsIntermediate, i)
                label.delete(array.get(swingHighLabels, i))

        for i = 0 to swingLowCount - 1 by 1
            if not array.get(swingLowIsIntermediate, i)
                label.delete(array.get(swingLowLabels, i))


// detect swing highs and lows
swingHighPrice = ta.pivothigh(high, inputPivotBars, inputPivotBars)
swingLowPrice = ta.pivotlow(low, inputPivotBars, inputPivotBars)


if not na(swingHighPrice)
    lastSwingHighPrice = array_peek(swingHighs)
    isHigherHigh = swingHighPrice > lastSwingHighPrice
    isLowerHigh = swingHighPrice < lastSwingHighPrice
    swingLabel = label.new(bar_index[inputPivotBars], swingHighPrice, color=highcolor, yloc=yloc.price, style=label.style_circle, size=size.tiny)

    // check if last swing high was intermediate
    if isLowerHigh and array_peek(swingHighIsHigher)
        // lower high after a higher high means the previous swing high was intermediate
        if inputHighlightIntermediates
            label.set_size(array_peek(swingHighLabels), intermediateLabelSize)
            array.set(swingHighIsIntermediate, array.size(swingHighIsIntermediate) - 1, true)

    // save swing
    array.push(swingHighs, swingHighPrice)
    array.push(swingHighLabels, swingLabel)
    array.push(swingHighIsHigher, isHigherHigh)
    array.push(swingHighIsIntermediate, false)  // can be filled in later, if a lower high forms next

if not na(swingLowPrice)
    lastSwingLowPrice = array_peek(swingLows)
    isHigherLow = swingLowPrice > lastSwingLowPrice
    isLowerLow = swingLowPrice < lastSwingLowPrice
    swingLabel = label.new(bar_index[inputPivotBars], swingLowPrice, color=lowcolor, yloc=yloc.price, style=label.style_circle, size=size.tiny)

    // check if last swing low was intermediate
    if isHigherLow and array_peek(swingLowIsLower)
        // higher low after a lower low means the previous swing low was intermediate
        if inputHighlightIntermediates
            label.set_size(array_peek(swingLowLabels), intermediateLabelSize)
            array.set(swingLowIsIntermediate, array.size(swingLowIsIntermediate) - 1, true)

    // save swing
    array.push(swingLows, swingLowPrice)
    array.push(swingLowLabels, swingLabel)
    array.push(swingLowIsLower, isLowerLow)
    array.push(swingLowIsIntermediate, false)  // can be filled in later if a higher low forms next


remove_short_term_swings()


//IMBALANCE
show_IMB = input.bool(true, "Imbalance", group='IMBALANCE')
imbalancecolor = input.color(color.yellow, title="Imbalance Color", group='IMBALANCE')
fvgTransparency  = input(title="Transparency", defval=60, group='IMBALANCE')
fvgboxLength = input.int(title='Length', defval=0, group='IMBALANCE')

fvgisUp(index) =>
    close[index] > open[index]

fvgisDown(index) =>
    close[index] < open[index]


fvgisObUp(index) =>
    fvgisDown(index + 1) and fvgisUp(index) and close[index] > high[index + 1]


fvgisObDown(index) =>
    fvgisUp(index + 1) and fvgisDown(index) and close[index] < low[index + 1]


bullishFvg = low[0] > high[2]
bearishFvg = high[0] < low[2]
if bullishFvg and show_IMB
    box.new(left=bar_index - 1, top=low[0], right=bar_index + fvgboxLength, bottom=high[2], bgcolor=color.new(imbalancecolor, fvgTransparency), border_color=color.new(imbalancecolor, fvgTransparency))
if bearishFvg and show_IMB
    box.new(left=bar_index - 1, top=low[2], right=bar_index + fvgboxLength, bottom=high[0], bgcolor=color.new(imbalancecolor, fvgTransparency), border_color=color.new(imbalancecolor, fvgTransparency))
//////////////////// FVG //////////////////

//---------------------------------opening gapes intrigation---------------------------------------------



type gap
    float high
    float low
    int start
    int end

var string nwogGroup = "New Week Opening Gap"
var string ndogGroup = "New Day Opening Gap"
var string generalSettings = "General Settings"
var string openLineSettings = "Week & Day Open"

bool showNWOG = input.bool(true, "", inline = "1", group = nwogGroup)
string nwogLabel = input.string("NWOG", "", inline = "1", group = nwogGroup)
color nwogBg = input.color(color.rgb(164, 249, 73, 85), "", inline = "1", group = nwogGroup)
bool showNwogCE = input.bool(false, "NWOG C.E.", tooltip = "C.E. - Consequent Encroachment or 'middle point' of any Gap or Inefficiency.", group = nwogGroup, inline = "2")
string nwogCEStyle = input.string("dotted", "", options = ["dotted", "dashed", "solid"], group = nwogGroup, inline = "2")
color nwogCEColor = input.color(color.blue, "", group = nwogGroup, inline = "2")
string nwogLabelXPosition = input.string('right', title = "Label", options = ["left", "center", "right"], inline = "5", group = nwogGroup)
string nwogLabelYPosition = input.string('top', title = "", options = ["top", "center", "bottom"], inline = "5", group = nwogGroup)
string nwogLabelSize = input.string('small', title = "", options = ["tiny", "small", "normal", "large", "huge"], inline = "5", group = nwogGroup)
color nwogLabelColor = input.color(color.black, "", inline = "5", group = nwogGroup)
int nwogsAmount = input.int(4, "Previous NWOGs", minval = 1, maxval = 100, inline = "3", group = nwogGroup)
color previousNwogBg = input.color(color.rgb(0, 0, 0, 90), "", inline = "3", group = nwogGroup)
bool extendAllNwogs = input.bool(false, "Extend Previous NWOGs", group = nwogGroup)
bool extendToCurrentDayCloseTime = input.bool(true, "Extend to Current Day", tooltip = "Otherwise it will be extended to the end of the week", group = nwogGroup)

bool showNDOG = input.bool(true, "", inline = "2", group = ndogGroup)
string ndogLabel = input.string("NDOG", "", inline = "2", group = ndogGroup)
color ndogBg = input.color(color.rgb(255, 235, 59, 85), "", inline = "2", group = ndogGroup)
bool showNdogCE = input.bool(false, "NDOG C.E.", tooltip = "C.E. - Consequent Encroachment or 'middle point' of any Gap or Inefficiency.", group = ndogGroup, inline = "3")
string ndogCEStyle = input.string("dotted", "", options = ["dotted", "dashed", "solid"], group = ndogGroup, inline = "3")
color ndogCEColor = input.color(color.blue, "", group = ndogGroup, inline = "3")
string ndogLabelXPosition = input.string('right', title = "Label", options = ["left", "center", "right"], inline = "5", group = ndogGroup)
string ndogLabelYPosition = input.string('top', title = "", options = ["top", "center", "bottom"], inline = "5", group = ndogGroup)
string ndogLabelSize = input.string('small', title = "", options = ["tiny", "small", "normal", "large", "huge"], inline = "5", group = ndogGroup)
color ndogLabelColor = input.color(color.black, "", inline = "5", group = ndogGroup)
int ndogsAmount = input.int(4, "Previous NDOG", minval = 1, maxval = 100, inline = "4", group = ndogGroup)
color previousNdogBg = input.color(color.rgb(0, 0, 0, 90), "", inline = "4", group = ndogGroup)
bool extendAllNdogs = input.bool(false, "Extend Previous NDOGs", group = ndogGroup)

bool eventHorizon = input.bool(false, "Event Horizon", inline = "2", group = generalSettings)
string eventHorizonLineStyle = input.string("dashed", "", options = ["dotted", "dashed", "solid"], group = generalSettings, inline = "2")
color eventHorizonLineColor = input.color(color.red, "", inline = "2", group = generalSettings)

bool fiveToSixGap = input.bool(true, "5pm to 6pm GAP", tooltip = "This option will show only 5pm to 6pm gaps. If you will see at the daily timeframe there is a big difference between previous day close and current day open GAP and 5pm to 6pm GAP. This option allows you to choose which GAP to use.", group = generalSettings)
bool showPriceLabels = input.bool(false, "Price Labels", inline = "1", group = generalSettings)
string priceLabelSize = input.string('small', title = "", options = ["tiny", "small", "normal", "large", "huge"], inline = "1", group = generalSettings)
color priceLabelColor = input.color(color.black, "", inline = "1", group = generalSettings)
bool showDateLabel = input.bool(true, "Show date label", group = generalSettings)
string dateFormat = input.string("dd.MM", title = "Date Format", options = ["dd.MM", "MM.dd", "dd.MM.yy", "MM.dd.yy"], group = generalSettings)

getGapData() =>
    gap.new(math.max(close[1], open), math.min(close[1], open), time, time_close)

gap weekOpeningGap = request.security(syminfo.tickerid, "1W", getGapData(), lookahead =  barmerge.lookahead_on)
[dayOpeningGap, currentDayTimeClose] = request.security(syminfo.tickerid, "1D", [getGapData(), time_close], lookahead =  barmerge.lookahead_on)
[isNewWeek, hourPreviousBarClose, hourCurrentBarOpen] = request.security(syminfo.tickerid, "240", [helpers.isNewbar("W"), close[1], open], lookahead =  barmerge.lookahead_on)

if timeframe.isintraday and helpers.isNewbar("D") and fiveToSixGap
    dayOpeningGap.high := math.max(close[1], open)
    dayOpeningGap.low := math.min(close[1], open)

if timeframe.multiplier < 60
    if isNewWeek and fiveToSixGap
        weekOpeningGap.high := math.max(hourPreviousBarClose, hourCurrentBarOpen)
        weekOpeningGap.low := math.min(hourPreviousBarClose, hourCurrentBarOpen)
else if (timeframe.isdaily or timeframe.isintraday) and helpers.isNewbar("W") and fiveToSixGap
    weekOpeningGap.high := math.max(close[1], open)
    weekOpeningGap.low := math.min(close[1], open)

var array<box> nwogArray = array.new<box>(0)
var array<line> nwogCEArray = array.new<line>(0)
var array<label> nwogHighLabel = array.new<label>(0)
var array<label> nwogCELabel = array.new<label>(0)
var array<label> nwogLowLabel = array.new<label>(0)

var array<box> ndogArray = array.new<box>(0)
var array<line> ndogCEArray = array.new<line>(0)
var array<label> ndogHighLabel = array.new<label>(0)
var array<label> ndogCELabel = array.new<label>(0)
var array<label> ndogLowLabel = array.new<label>(0)

var line eventHorizonLine = na

if showNWOG and (timeframe.isdaily or timeframe.isintraday) 
    if helpers.isNewbar("W") // if (hour(time, "America/New_York") == 9 and minute(time, America/New_York) == 30 and nineThirtyGap) or (not nineThirtyGap and helpers.isNewbar("W"))
        string weekLabel = showDateLabel ? str.format_time(weekOpeningGap.start, dateFormat, syminfo.timezone) + " - " + str.format_time(weekOpeningGap.end, dateFormat, syminfo.timezone) + " | " + nwogLabel : nwogLabel
        float nwogCePrice = (weekOpeningGap.high + weekOpeningGap.low) / 2
        
        array.push(nwogArray, box.new(weekOpeningGap.start, weekOpeningGap.high, weekOpeningGap.end, weekOpeningGap.low, xloc = xloc.bar_time, bgcolor = nwogBg, border_width = 0, text = weekLabel, text_size = helpers.getTextSize(nwogLabelSize), text_halign = helpers.getBoxTextPosition(nwogLabelXPosition), text_valign = helpers.getBoxTextPosition(nwogLabelYPosition), text_color = nwogLabelColor))
        
        if showNwogCE
            array.push(nwogCEArray, line.new(weekOpeningGap.start, nwogCePrice, weekOpeningGap.end, nwogCePrice, xloc = xloc.bar_time, style = helpers.getLineStyle(nwogCEStyle), color = nwogCEColor))
        
        if showPriceLabels
            array.push(nwogHighLabel, label.new(weekOpeningGap.end, weekOpeningGap.high, str.tostring(weekOpeningGap.high, format.mintick), style = label.style_label_lower_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = priceLabelColor, size = helpers.getTextSize(priceLabelSize)))
            array.push(nwogCELabel, label.new(weekOpeningGap.end, nwogCePrice, str.tostring(nwogCePrice, format.mintick), style = label.style_label_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = priceLabelColor, size = helpers.getTextSize(priceLabelSize)))
            array.push(nwogLowLabel, label.new(weekOpeningGap.end, weekOpeningGap.low, str.tostring(weekOpeningGap.low, format.mintick), style = label.style_label_upper_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = priceLabelColor, size = helpers.getTextSize(priceLabelSize)))

        if array.size(nwogArray) > nwogsAmount
            box.delete(array.shift(nwogArray))
            
            if showNwogCE
                line.delete(array.shift(nwogCEArray))
            
            if showPriceLabels
                label.delete(array.shift(nwogHighLabel))
                label.delete(array.shift(nwogCELabel))
                label.delete(array.shift(nwogLowLabel))
        
        if eventHorizon and array.size(nwogArray) > 1
            box currentNwog = array.last(nwogArray)
            box previousNwog = array.get(nwogArray, array.size(nwogArray) - 2)

            float currentNwog_high = box.get_top(currentNwog)
            float currentNwog_low = box.get_bottom(currentNwog)
            
            float previousNwog_high = box.get_top(previousNwog)
            float previousNwog_low = box.get_bottom(previousNwog)
            
            float eventHorizonLevel = 0.0

            if currentNwog_high > previousNwog_high and currentNwog_low > previousNwog_high
                eventHorizonLevel := (currentNwog_low + previousNwog_high) / 2
            else if previousNwog_high > currentNwog_high and previousNwog_low > currentNwog_high
                eventHorizonLevel := (previousNwog_low + currentNwog_high) / 2

            eventHorizonLine := line.new(weekOpeningGap.start, eventHorizonLevel, weekOpeningGap.end, eventHorizonLevel, xloc = xloc.bar_time, style = helpers.getLineStyle(eventHorizonLineStyle), color = eventHorizonLineColor)
            line.delete(eventHorizonLine[1])

    if helpers.isNewbar("D") 
        if extendAllNwogs and array.size(nwogArray) > 0
            for i = array.size(nwogArray) - 1 to 0
                extendTo = extendToCurrentDayCloseTime ? currentDayTimeClose : weekOpeningGap.end
                box.set_right(array.get(nwogArray, i), extendTo)
                
                if i != array.size(nwogArray) - 1
                    box.set_bgcolor(array.get(nwogArray, i), previousNwogBg)

                if showNwogCE
                    line.set_x2(array.get(nwogCEArray, i), extendTo)
                
                if showPriceLabels
                    label.set_x(array.get(nwogHighLabel, i), extendTo)
                    label.set_x(array.get(nwogCELabel, i), extendTo)
                    label.set_x(array.get(nwogLowLabel, i), extendTo)

        if extendToCurrentDayCloseTime and array.size(nwogArray) > 0
            box.set_right(array.last(nwogArray), currentDayTimeClose)
            
            if showNwogCE
                line.set_x2(array.last(nwogCEArray), currentDayTimeClose)
                
            if showPriceLabels
                label.set_x(array.last(nwogHighLabel), currentDayTimeClose)
                label.set_x(array.last(nwogCELabel), currentDayTimeClose)
                label.set_x(array.last(nwogLowLabel), currentDayTimeClose)
            
            if eventHorizon
                line.set_x2(eventHorizonLine, currentDayTimeClose)

if showNDOG and timeframe.isintraday
    if helpers.isNewbar("D")// and dayOpeningGap.high != dayOpeningGap.low
        if (dayofweek != dayofweek.sunday and showNWOG) or not showNWOG
            string dayLabel = showDateLabel ? str.format_time(dayOpeningGap.start, dateFormat, syminfo.timezone) + " | " + ndogLabel : ndogLabel //showDayLabels ? getDayOfWeekLabel(dayofweek) + " | " + ndogLabel : ndogLabel
            float ndogCePrice = (dayOpeningGap.high + dayOpeningGap.low) / 2
            
            array.push(ndogArray, box.new(dayOpeningGap.start, dayOpeningGap.high, dayOpeningGap.end, dayOpeningGap.low, xloc = xloc.bar_time, bgcolor = ndogBg, border_width = 0, text = dayLabel, text_size = helpers.getTextSize(ndogLabelSize), text_halign = helpers.getBoxTextPosition(ndogLabelXPosition), text_valign = helpers.getBoxTextPosition(ndogLabelYPosition), text_color = ndogLabelColor))
        
            if showNdogCE
                array.push(ndogCEArray, line.new(dayOpeningGap.start, ndogCePrice, dayOpeningGap.end, ndogCePrice, xloc = xloc.bar_time, style = helpers.getLineStyle(ndogCEStyle), color = ndogCEColor))

            if showPriceLabels
                array.push(ndogHighLabel, label.new(dayOpeningGap.end, dayOpeningGap.high, str.tostring(dayOpeningGap.high, format.mintick), style = label.style_label_lower_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = priceLabelColor, size = helpers.getTextSize(priceLabelSize)))
                array.push(ndogCELabel, label.new(dayOpeningGap.end, ndogCePrice, str.tostring(ndogCePrice, format.mintick), style = label.style_label_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = priceLabelColor, size = helpers.getTextSize(priceLabelSize)))
                array.push(ndogLowLabel, label.new(dayOpeningGap.end, dayOpeningGap.low, str.tostring(dayOpeningGap.low, format.mintick), style = label.style_label_upper_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = priceLabelColor, size = helpers.getTextSize(priceLabelSize)))

            if array.size(ndogArray) > ndogsAmount
                box.delete(array.shift(ndogArray))

                if showNdogCE
                    line.delete(array.shift(ndogCEArray))
                
                if showPriceLabels
                    label.delete(array.shift(ndogHighLabel))
                    label.delete(array.shift(ndogCELabel))
                    label.delete(array.shift(ndogLowLabel))

        
    if extendAllNdogs and array.size(ndogArray) > 0
        for i = 0 to array.size(ndogArray) - 1
            box.set_right(array.get(ndogArray, i), dayOpeningGap.end)
            
            if (showNWOG and dayofweek == dayofweek.sunday and i <= array.size(ndogArray) - 1) or i < array.size(ndogArray) - 1
                box.set_bgcolor(array.get(ndogArray, i), previousNdogBg)

            if showNdogCE
                line.set_x2(array.get(ndogCEArray, i), dayOpeningGap.end)
            
            if showPriceLabels
                label.set_x(array.get(ndogHighLabel, i), dayOpeningGap.end)
                label.set_x(array.get(ndogCELabel, i), dayOpeningGap.end)
                label.set_x(array.get(ndogLowLabel, i), dayOpeningGap.end)
				
//----------------------------------------------------------opening gapes intrigation--------------------------------------------

//=====================================================================================
// Regular Trading Hours GAP (RTH/ETH gap) - merged from @twingall's indicator
// Gap between the 4:15pm (4pm on SPY) close and the 9:30am NY open. Index futures (ES, YM, NQ).
// Boxes only appear on 15min or lower timeframes. Identifiers renamed where they clashed with ICT code.
//=====================================================================================
rthBoxMs = math.round(6.5*1000*3600)
longDay = 24*1000*3600
isSPY = str.tostring(syminfo.ticker) =="SPY"? true:false
_16_00= timestamp('America/New_York', year, month, dayofmonth, 16, 00, 00)
_16_15= timestamp('America/New_York', year, month, dayofmonth, 16, 15, 00)
_9_30 = timestamp('America/New_York', year, month, dayofmonth, 9, 30, 00)
colorNone = color.new(color.white, 100)
showBox = input.bool(true, "Standard Gap (4:15pm close - 9:30am open)| ", inline = '-3' , group = 'boxes & midlines', tooltip = "Shows the standard RTH gap from the close at 4:15pm to 9:30am open (New York Time)\n\n Note on SPY RTH close is 4pm; this will automatically adjust to this fact")
boxColor = input.color(color.new(color.purple, 90), "Box", inline ='-3', group = 'boxes & midlines')
borderColor=input.color(color.new(color.blue, 80), "Border", inline ='-3', group = 'boxes & midlines')
showRthMidline = input.bool(true, "show midline", inline ='-2', group = 'boxes & midlines')
rthMidCol = input.color(color.red, "", inline ='-2', group = 'boxes & midlines')
rthMidStyle = input.string(line.style_dotted, "| style:", options = [line.style_solid, line.style_dotted, line.style_dashed, line.style_arrow_left, line.style_arrow_right, line.style_arrow_both], inline ='-2', group = 'boxes & midlines' )
showRthMidLab = input.bool(true, "show label", inline ='-2', group = 'boxes & midlines')

showHiLoBox = input.bool (false, "High-low Gap (4:15pm - 9:30am) |", inline ='-1', group = 'boxes & midlines', tooltip = "Shows the gap (as box) between high/low of final candle (the candle ending at 4:15pm) to the high/low of first RTH candle (the candle starting at 9:30am)\n\n(New York Time)\n\nNote that as you climb higher in timeframes, the last RTH candle and first RTH candle will be larger =>> wicks more likely to overlap =>> less gap boxes will appear. Ideal use is 5min timeframe or lower.")
boxColor2 = input.color(color.new(color.green, 75), "Box", inline ='-1', group = 'boxes & midlines')
borderColor2=input.color(color.new(color.red, 80), "Border", inline ='-1', group = 'boxes & midlines')
showHiLoMidline = input.bool(false, "show midline", inline ='0', group = 'boxes & midlines')
HiLoMidCol = input.color(color.green, "", inline ='0', group = 'boxes & midlines')
HiLoMidStyle = input.string(line.style_dotted, "| style:", options = [line.style_solid, line.style_dotted, line.style_dashed, line.style_arrow_left, line.style_arrow_right, line.style_arrow_both], inline ='0', group = 'boxes & midlines' )
showHiloMidLab = input.bool(true, "show label", inline ='0', group = 'boxes & midlines')

boxesToShow =input.int(2, "historical Boxes & Midlines to show", inline = '1', group = 'boxes & midlines')
showTxt =input.bool(true, "Box text", inline='2', group = 'boxes & midlines')
boxTxtCol = input.color(color.new(color.gray, 30), "", inline ='2', group = 'boxes & midlines')
txtValignChoice = input.string(text.align_top, "Position:", options = [text.align_top, text.align_center, text.align_bottom], inline ='2', group = 'boxes & midlines')
txtHalignChoice = input.string(text.align_center, "", options = [text.align_center, text.align_left, text.align_right], inline ='2', group = 'boxes & midlines')
extendBoxRight = input.bool (false, "extend boxes & midlines right", inline ='3', group = 'boxes & midlines', tooltip = "recommend only using this setting with historical boxes to show = 1")

extChoiceBox = extendBoxRight?extend.right:extend.none

openOffset = input.int(0, "+/- offset (minutes) from 9:30am NY time", step = 5, group = 'time adjustment (for non-USA based Indices)', tooltip = "Added to support non-USA based indices. User can input their offset from NY time (UTC-4), then save settings (bottom left)\n\nI.e. you might try offset values of '-300' and '-300' for London based Indices; Untested, try it out for yourself.\n\n Note that the offset in minutes must be divisible into the timeframe you're plotting on, or nothing will display")
closeOffset = input.int(0, "+/- offset (minutes) from 4:15pm NY time", step = 5, group = 'time adjustment (for non-USA based Indices)')

linesToShow=input.int(2, "historical RTH close Lines & labels to show", group = 'RTH close lines & labels')
showRTHcloseLine =input.bool(true, "show prev RTH close line", inline ='2', group = 'RTH close lines & labels')
showRTHcloseLab = input.bool(true, "show price label", inline ='2', group = 'RTH close lines & labels')

RTHcloseColor = input.color(color.new(color.blue, 10), "", inline ='2', group = 'RTH close lines & labels')
extendLineRight = input.bool (false, "extend lines right", inline ='3', group = 'RTH close lines & labels')
linestyleRTH = input.string(line.style_dotted, "| style:", options = [line.style_solid, line.style_dotted, line.style_dashed, line.style_arrow_left, line.style_arrow_right, line.style_arrow_both], inline ='3', group = 'RTH close lines & labels')
RTH_line_width = input.int(2, "| width", options = [1,2,3,4], inline ='3', group = 'RTH close lines & labels')
extChoiceLine = extendLineRight?extend.right:extend.none
_minute = 1000*60
rthCloseA = ta.valuewhen(time_close == _16_00 + closeOffset*_minute, close, 0)
rthCloseB = ta.valuewhen(time_close ==_16_15 + closeOffset *_minute, close, 0)
rthClose = isSPY ? rthCloseA : rthCloseB

DayOfWeekStr(int _time)=>
    string DoW = dayofweek(_time, 'America/New_York') == 2? "Mon":
                 dayofweek(_time, 'America/New_York') == 3? "Tues":
                 dayofweek(_time, 'America/New_York') == 4? "Weds":
                 dayofweek(_time, 'America/New_York') == 5? "Thurs":
                 dayofweek(_time, 'America/New_York') == 6? "Fri":na

useNoPlotSession = input.bool(false, "Use no plot session (when 'extend right' is toggled on)", group = "no plot session", inline='1', tooltip = "boxes/lines/labels will stop painting through these hours..\n\nBut will resume painting to the last bar index outside of these hours\n\n only applies when 'extend boxes and lines right' is toggled on")
inputSession1 = input.session('1600-0830', title='stop painting boxes/lines during these hours', group = "no plot session", inline='2')
inSession1 = not na(time(timeframe.period, str.tostring(inputSession1), "America/New_York")) 
barTime = timeframe.in_seconds(timeframe.period)*1000

var int rthNoPlotMs = 0

var box bx = na
var array<box> boxArr = array.new<box>(0)
var line lnRthMid = na
var array<line> lnRthMidArr = array.new<line>(0)
var label labRthMid =na
var array<label> labRthMidArr = array.new<label>(0)
rthMidVal = math.min(rthClose, open) + 0.5* math.abs(rthClose-open)
if time == (_9_30 +openOffset *_minute) and showBox
    bx:=box.new(time, rthClose, extendBoxRight?last_bar_time: time+rthBoxMs, open, xloc = xloc.bar_time,bgcolor = boxColor, border_color = borderColor, extend =extend.none , text =showTxt?"rth >>"+DayOfWeekStr(time):"", text_color = boxTxtCol, text_size = size.small, text_valign =txtValignChoice, text_halign = txtHalignChoice) //time+rthBoxMs
    array.push(boxArr,bx)
    if array.size(boxArr)>boxesToShow
        box.delete(array.shift(boxArr))

if time == (_9_30 +openOffset *_minute) and showRthMidline
    lnRthMid:= line.new(time, rthMidVal, extendBoxRight?last_bar_time: time+rthBoxMs, rthMidVal, xloc = xloc.bar_time, color = rthMidCol, style = rthMidStyle, width = 1, extend = extend.none )
    array.push(lnRthMidArr, lnRthMid)
    labRthMid:= label.new(extendBoxRight?last_bar_time: time+rthBoxMs, rthMidVal, "mid >>"+DayOfWeekStr(time)+" = " + str.tostring(rthMidVal, format.mintick), xloc=xloc.bar_time, textcolor = showRthMidLab?rthMidCol:colorNone, style=label.style_none )
    array.push(labRthMidArr, labRthMid)
    if array.size(lnRthMidArr)>boxesToShow
        line.delete(array.shift(lnRthMidArr))
    if array.size(labRthMidArr)>boxesToShow
        label.delete(array.shift(labRthMidArr))

four15HiA = ta.valuewhen(time_close == _16_00 + closeOffset*_minute, high, 0)
four15HiB = ta.valuewhen(time_close ==_16_15 + closeOffset *_minute, high, 0)
four15Hi = isSPY ? four15HiA : four15HiB
four15LoA = ta.valuewhen(time_close == _16_00 + closeOffset*_minute, low, 0)
four15LoB = ta.valuewhen(time_close ==_16_15 + closeOffset *_minute, low, 0)
four15Lo = isSPY ? four15LoA : four15LoB
four15HiLo = low>four15Hi?four15Hi:high<four15Lo?four15Lo:na
HiLo = low>four15Hi? low:high<four15Lo?high:na
var box bx2 = na
var array<box> boxArr2 = array.new<box>(0)
var line lnHiLoMid = na
var array<line> lnHiLoMidArr = array.new<line>(0)
var label labHiLoMid =na
var array<label> labHiLoMidArr = array.new<label>(0)
HiLoMidVal = math.min(four15HiLo, HiLo) + 0.5* math.abs(four15HiLo-HiLo)
if time == (_9_30 +openOffset *_minute) and showHiLoBox
    bx2:=box.new(time, four15HiLo, extendBoxRight?last_bar_time: time+rthBoxMs,HiLo, xloc = xloc.bar_time,bgcolor = boxColor2, border_color = borderColor2, extend = extend.none , text =showTxt?"hilo >>"+DayOfWeekStr(time):"", text_color = boxTxtCol, text_size = size.small, text_valign =txtValignChoice, text_halign = txtHalignChoice)
    array.push(boxArr2,bx2)
    if array.size(boxArr2)>boxesToShow
        box.delete(array.shift(boxArr2))
if time == (_9_30 +openOffset *_minute) and showHiLoMidline
    lnHiLoMid:= line.new(time, HiLoMidVal, extendBoxRight?last_bar_time: time+rthBoxMs, HiLoMidVal, xloc = xloc.bar_time, color = HiLoMidCol, style = HiLoMidStyle, width = 1, extend = extend.none)
    array.push(lnHiLoMidArr, lnHiLoMid)
    labHiLoMid:= label.new(extendBoxRight?last_bar_time: time+rthBoxMs, HiLoMidVal, "mid >>"+DayOfWeekStr(time)+" = " + str.tostring(HiLoMidVal, format.mintick), xloc=xloc.bar_time, textcolor = showHiloMidLab?HiLoMidCol:colorNone, style=label.style_none )
    array.push(labHiLoMidArr, labHiLoMid)
    if array.size(lnHiLoMidArr)>boxesToShow
        line.delete(array.shift(lnHiLoMidArr))
    if array.size(labHiLoMidArr)>boxesToShow
        label.delete(array.shift(labHiLoMidArr))

var line rthCloseLn = na
var label lab1 =na
var array<line> lineArr = array.new<line>(0)
var array<label> labelArr = array.new<label>(0)
condRTHclose = isSPY? session.islastbar_regular: (time ==_16_15 + closeOffset *_minute)
if condRTHclose 
    rthCloseLn:=line.new(time_close,isSPY?close:close[1], extendLineRight?last_bar_time:time+longDay, isSPY?close:close[1] , xloc=xloc.bar_time, color = showRTHcloseLine?RTHcloseColor:colorNone, extend =extend.none , style=linestyleRTH, width =RTH_line_width)
    array.push(lineArr,rthCloseLn)
    lab1:=label.new(extendLineRight?last_bar_time:time_close[1]+longDay, isSPY?close:close[1],DayOfWeekStr(time) + " rth close = "+ str.tostring(isSPY?close:close[1]), xloc=xloc.bar_time, textcolor = showRTHcloseLab?RTHcloseColor:colorNone, style=label.style_none)
    array.push(labelArr,lab1)
    
    if array.size(lineArr)>linesToShow
        line.delete(array.shift(lineArr))
    if array.size(labelArr)>linesToShow
        label.delete(array.shift(labelArr))

if inSession1
    rthNoPlotMs+=barTime
if not inSession1 and inSession1[1]
    rthNoPlotMs:=0
// bgcolor(inSession1?color.new(color.red, 85):na)
if useNoPlotSession
    int noPlotEnd = last_bar_time - rthNoPlotMs
    if extendBoxRight
        for bx_ in boxArr
            box.set_right(bx_, noPlotEnd)
        for bx_ in boxArr2
            box.set_right(bx_, noPlotEnd)
        for ln_ in lnRthMidArr
            line.set_x2(ln_, noPlotEnd)
        for lb_ in labRthMidArr
            label.set_x(lb_, noPlotEnd)
        for ln_ in lnHiLoMidArr
            line.set_x2(ln_, noPlotEnd)
        for lb_ in labHiLoMidArr
            label.set_x(lb_, noPlotEnd)
    if extendLineRight
        for ln_ in lineArr
            line.set_x2(ln_, noPlotEnd)
        for lb_ in labelArr
            label.set_x(lb_, noPlotEnd)

//=====================================================================================
// HTF CANDLES (merged from "ICT HTF Candles (fadi)" by @fadizeidan, MPL 2.0)
// Backported from Pine v6 to v5. Renamed to avoid clashes with the ICT code:
//   Helper->HCHelper, Settings->HCSettings, Imbalance->HCImbalance,
//   settings->hcs, helper->hch, htf_1..6->hc_tf_1..6,
//   methods FindImbalance->HCFindImbalance, LineStyle->HCLineStyle (overloaded methods can't use globals)
//=====================================================================================

type Candle
    float o
    float c
    float h
    float l
    int o_time
    int o_idx
    int c_idx
    int h_idx
    int l_idx
    string dow
    box body
    line wick_up
    line wick_down
    label dow_label

type Trace
    line o
    line c
    line h
    line l
    label o_l
    label c_l
    label h_l
    label l_l

type HCImbalance
    box b
    int idx

type CandleSettings
    bool show
    string htf
    int max_display

type HCSettings
    int max_sets
    color bull_body
    color bull_border
    color bull_wick
    color bear_body
    color bear_border
    color bear_wick
    int offset
    int buffer
    int htf_buffer
    int width
    bool use_custom_daily
    string custom_daily
    bool daily_name
    bool trace_show
    color trace_o_color
    string trace_o_style
    int trace_o_size
    color trace_c_color
    string trace_c_style
    int trace_c_size
    color trace_h_color
    string trace_h_style
    int trace_h_size
    color trace_l_color
    string trace_l_style
    int trace_l_size
    string trace_anchor
    bool label_show
    color label_color
    string label_size
    string label_position
    string label_alignment
    bool fvg_show
    color fvg_color
    bool vi_show
    color vi_color
    bool htf_label_show
    color htf_label_color
    string htf_label_size
    bool htf_timer_show
    color htf_timer_color
    string htf_timer_size
    color dow_color
    string dow_size

type CandleSet
    array<Candle> candles
    array<HCImbalance> imbalances
    CandleSettings settings
    int htfTime
    label tfNameTop
    label tfNameBottom
    label tfTimerTop
    label tfTimerBottom

type HCHelper
    string name = 'HCHelper'

HCSettings hcs = HCSettings.new()

var CandleSettings SettingsHTF1 = CandleSettings.new()
var CandleSettings SettingsHTF2 = CandleSettings.new()
var CandleSettings SettingsHTF3 = CandleSettings.new()
var CandleSettings SettingsHTF4 = CandleSettings.new()
var CandleSettings SettingsHTF5 = CandleSettings.new()
var CandleSettings SettingsHTF6 = CandleSettings.new()

var array<Candle> candles_1 = array.new<Candle>(0)
var array<Candle> candles_2 = array.new<Candle>(0)
var array<Candle> candles_3 = array.new<Candle>(0)
var array<Candle> candles_4 = array.new<Candle>(0)
var array<Candle> candles_5 = array.new<Candle>(0)
var array<Candle> candles_6 = array.new<Candle>(0)

var array<HCImbalance> imbalances_1 = array.new<HCImbalance>()
var array<HCImbalance> imbalances_2 = array.new<HCImbalance>()
var array<HCImbalance> imbalances_3 = array.new<HCImbalance>()
var array<HCImbalance> imbalances_4 = array.new<HCImbalance>()
var array<HCImbalance> imbalances_5 = array.new<HCImbalance>()
var array<HCImbalance> imbalances_6 = array.new<HCImbalance>()

var CandleSet htf1 = CandleSet.new()
htf1.settings := SettingsHTF1
htf1.candles := candles_1
htf1.imbalances := imbalances_1

var CandleSet htf2 = CandleSet.new()
htf2.settings := SettingsHTF2
htf2.candles := candles_2
htf2.imbalances := imbalances_2

var CandleSet htf3 = CandleSet.new()
htf3.settings := SettingsHTF3
htf3.candles := candles_3
htf3.imbalances := imbalances_3

var CandleSet htf4 = CandleSet.new()
htf4.settings := SettingsHTF4
htf4.candles := candles_4
htf4.imbalances := imbalances_4

var CandleSet htf5 = CandleSet.new()
htf5.settings := SettingsHTF5
htf5.candles := candles_5
htf5.imbalances := imbalances_5

var CandleSet htf6 = CandleSet.new()
htf6.settings := SettingsHTF6
htf6.candles := candles_6
htf6.imbalances := imbalances_6

var array<CandleSet> hc_sets = array.new<CandleSet>(0)
if barstate.isfirst
    hc_sets.push(htf1)
    hc_sets.push(htf2)
    hc_sets.push(htf3)
    hc_sets.push(htf4)
    hc_sets.push(htf5)
    hc_sets.push(htf6)

//+------------------------------------------------------------------------------------------------------------+//
//+--- HCSettings                                                                                             ---+//
//+------------------------------------------------------------------------------------------------------------+//

string group_style              = "Styling  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_label              = "Label HCSettings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_imbalance          = "HCImbalance  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string group_trace              = "Trace  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

htf1.settings.show              := input.bool(true, 'HTF 1      ', inline = 'htf1', group = 'HTF Candles')
hc_tf_1                           = input.timeframe('5', '', inline = 'htf1', group = 'HTF Candles')
htf1.settings.htf := hc_tf_1
htf1.settings.max_display       := input.int(10, '', inline = 'htf1', group = 'HTF Candles')

htf2.settings.show              := input.bool(true, 'HTF 2      ', inline = 'htf2', group = 'HTF Candles')
hc_tf_2                           = input.timeframe('15', '', inline = 'htf2', group = 'HTF Candles')
htf2.settings.htf := hc_tf_2
htf2.settings.max_display       := input.int(10, '', inline = 'htf2', group = 'HTF Candles')

htf3.settings.show              := input.bool(true, 'HTF 3      ', inline = 'htf3', group = 'HTF Candles')
hc_tf_3                           = input.timeframe('60', '', inline = 'htf3', group = 'HTF Candles')
htf3.settings.htf := hc_tf_3
htf3.settings.max_display       := input.int(10, '', inline = 'htf3', group = 'HTF Candles')

htf4.settings.show              := input.bool(true, 'HTF 4      ', inline = 'htf4', group = 'HTF Candles')
hc_tf_4                           = input.timeframe('240', '', inline = 'htf4', group = 'HTF Candles')
htf4.settings.htf               := hc_tf_4
htf4.settings.max_display       := input.int(10, '', inline = 'htf4', group = 'HTF Candles')

htf5.settings.show              := input.bool(true, 'HTF 5      ', inline = 'htf5', group = 'HTF Candles')
hc_tf_5                           = input.timeframe('1D', '', inline = 'htf5', group = 'HTF Candles')
htf5.settings.htf := hc_tf_5
htf5.settings.max_display       := input.int(10, '', inline = 'htf5', group = 'HTF Candles')

htf6.settings.show              := input.bool(true, 'HTF 6      ', inline = 'htf6', group = 'HTF Candles')
hc_tf_6                           = input.timeframe('1W', '', inline = 'htf6', group = 'HTF Candles')
htf6.settings.htf               := hc_tf_6
htf6.settings.max_display       := input.int(10, '', inline = 'htf6', group = 'HTF Candles')

hcs.max_sets               := input.int(6, 'Limit to next HTFs only', minval = 1, maxval = 6, group = 'HTF Candles')
hcs.use_custom_daily       := input.bool(false, 'Custom daily candle open     ', inline='customdaily', group='HTF Candles')
hcs.custom_daily           := input.string('Midnight', '', options=['Midnight', '8:30', '9:30'], inline='customdaily', group='HTF Candles')
hcs.bull_body              := input.color(color.new(color.green, 10), 'Body  ', inline = 'body', group=group_style)
hcs.bear_body              := input.color(color.new(color.red, 10), '', inline = 'body', group=group_style)
hcs.bull_border            := input.color(color.new(color.black, 10), 'Borders', inline = 'borders', group=group_style)
hcs.bear_border            := input.color(color.new(color.black, 10), '', inline = 'borders', group=group_style)
hcs.bull_wick              := input.color(color.new(color.black, 10), 'Wick  ', inline = 'wick', group=group_style)
hcs.bear_wick              := input.color(color.new(color.black, 10), '', inline = 'wick', group=group_style)

hcs.offset                 := input.int(10, 'padding from current candles', minval = 1, group=group_style)
hcs.buffer                 := input.int(1, 'space between candles', minval = 1, maxval = 4, group=group_style)
hcs.htf_buffer             := input.int(10, 'space between Higher Timeframes', minval = 1, maxval = 10, group=group_style)
hcs.width                  := input.int(1, 'Candle Width', minval = 1, maxval = 4, group=group_style) * 2

hcs.htf_label_show         := input.bool(true, 'HTF Label           ', group=group_label, inline = 'HTFlabel')
hcs.htf_label_color        := input.color(color.new(color.black, 10), '', group=group_label, inline = 'HTFlabel')
hcs.htf_label_size         := input.string(size.large, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'HTFlabel')

hcs.label_position         := input.string("Both", 'Label Positions', options=['Both', 'Top', 'Bottom'], group=group_label)
hcs.label_alignment        := input.string("Align", "Label Alignment", options=['Align', 'Follow Candles'], group=group_label)

hcs.htf_timer_show         := input.bool(true, 'Remaining time      ', inline = 'timer', group=group_label)
hcs.htf_timer_color        := input.color(color.new(color.black, 10), '', inline = 'timer', group=group_label)
hcs.htf_timer_size         := input.string(size.normal, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'timer')

hcs.daily_name             := input.bool(false, 'Interval Value        ', group=group_label, inline = 'dow')
hcs.dow_color              := input.color(color.black , '', group=group_label, inline = 'dow')
hcs.dow_size               := input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], group=group_label, inline = 'dow')

hcs.fvg_show               := input.bool(true, 'Fair Value Gap   ', group = group_imbalance, inline = 'fvg')
hcs.fvg_color              := input.color(color.new(color.gray, 80), '', inline = 'fvg', group = group_imbalance)

hcs.vi_show                := input.bool(true, 'Volume HCImbalance', group = group_imbalance, inline = 'vi')
hcs.vi_color               := input.color(color.new(color.red, 50), '', inline = 'vi', group = group_imbalance)

hcs.trace_show             := input.bool(false, 'Trace lines', group = group_trace)
hcs.trace_o_color          := input.color(color.new(color.gray, 50), 'Open    ', inline = '1', group = group_trace)
hcs.trace_o_style          := input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '1', group = group_trace)
hcs.trace_o_size           := input.int(1, '', options = [1, 2, 3, 4], inline = '1', group = group_trace)
hcs.trace_c_color          := input.color(color.new(color.gray, 50), 'Close    ', inline = '2', group = group_trace)
hcs.trace_c_style          := input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '2', group = group_trace)
hcs.trace_c_size           := input.int(1, '', options = [1, 2, 3, 4], inline = '2', group = group_trace)
hcs.trace_h_color          := input.color(color.new(color.gray, 50), 'High     ', inline = '3', group = group_trace)
hcs.trace_h_style          := input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '3', group = group_trace)
hcs.trace_h_size           := input.int(1, '', options = [1, 2, 3, 4], inline = '3', group = group_trace)
hcs.trace_l_color          := input.color(color.new(color.gray, 50), 'Low     ', inline = '4', group = group_trace)
hcs.trace_l_style          := input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '4', group = group_trace)
hcs.trace_l_size           := input.int(1, '', options = [1, 2, 3, 4], inline = '4', group = group_trace)
hcs.trace_anchor           := input.string('First Timeframe', 'Anchor to', options = ['First Timeframe', 'Last Timeframe'], group = group_trace)

hcs.label_show             := input.bool(false, 'Price Label           ', inline = 'label', group = group_trace)
hcs.label_color            := input.color(color.new(color.black, 10), '', inline = 'label', group = group_trace)
hcs.label_size             := input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], inline = 'label', group = group_trace)

//+------------------------------------------------------------------------------------------------------------+//
//+--- Variables                                                                                            ---+//
//+------------------------------------------------------------------------------------------------------------+//

HCHelper hch = HCHelper.new()
var Trace trace = Trace.new()

//+------------------------------------------------------------------------------------------------------------+//
//+--- Internal Functions                                                                                   ---+//
//+------------------------------------------------------------------------------------------------------------+//

method HCLineStyle(HCHelper hch, string style) =>
    hch.name := style
    style == '----' ? line.style_dashed : style == '····' ? line.style_dotted : line.style_solid

method DayofWeek(HCHelper hch, int index) =>
    hch.name := 'DOW'
    int dIdx = nz(index, 1)
    dIdx >= 1 and dIdx <= 7 ? str.substring('MTWTFSS', dIdx - 1, dIdx) : ''

method ValidTimeframe(HCHelper hch, string HTF) =>
    hch.name := HTF
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n3 = n1 % n2
        n1 < n2 and math.round(n2 / n1) == n2 / n1


method RemainingTime(HCHelper hch, string HTF) =>
    hch.name := HTF
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)

        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
            r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
            r
        if days > 0
            r := str.tostring(days) + 'D ' + r
            r
        r
    else
        'n/a'

method HTFName(HCHelper hch, string HTF) =>
    hch.name := 'HTFName'
    formatted = HTF

    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
        formatted
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
        formatted
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
        formatted
    formatted

method HTFEnabled(HCHelper hch) =>
    hch.name := 'HTFEnabled'
    int enabled = 0
    enabled := enabled + (htf1.settings.show ? 1 : 0)
    enabled := enabled + (htf2.settings.show ? 1 : 0)
    enabled := enabled + (htf3.settings.show ? 1 : 0)
    enabled := enabled + (htf4.settings.show ? 1 : 0)
    enabled := enabled + (htf5.settings.show ? 1 : 0)
    enabled := enabled + (htf6.settings.show ? 1 : 0)
    int last = math.min(enabled, hcs.max_sets)

    last

method CandleSetHigh(HCHelper hch, array<Candle> candles, float h) =>
    hch.name := 'CandlesSetHigh'
    float _h = h
    for c in candles
        _h := math.max(_h, c.h)
    _h

method CandleSetLow(HCHelper hch, array<Candle> candles, float l) =>
    hch.name := 'CandlesSetLow'
    float _l = l
    for c in candles
        _l := math.min(_l, c.l)
    _l

method CandlesHigh(HCHelper hch, array<Candle> candles) =>
    hch.name := 'CandlesHigh'
    float h = 0.0
    int cnt = 0
    int last = hch.HTFEnabled()
    for st in hc_sets
        if st.settings.show and hch.ValidTimeframe(st.settings.htf) and cnt < last
            h := hch.CandleSetHigh(st.candles, h)
            cnt += 1
    h := hch.CandleSetHigh(candles, h)
    h

method CandlesLow(HCHelper hch, array<Candle> candles, float h) =>
    hch.name := 'CandlesLow'
    float l = h
    int cnt = 0
    int last = hch.HTFEnabled()
    for st in hc_sets
        if st.settings.show and hch.ValidTimeframe(st.settings.htf) and cnt < last
            l := hch.CandleSetLow(st.candles, l)
            cnt += 1
    l := hch.CandleSetLow(candles, l)
    l

method UpdateTime(CandleSet candleSet, int offset) =>
    if hcs.htf_timer_show and (barstate.isrealtime or barstate.islast)
        string tmr = '(' + hch.RemainingTime(candleSet.settings.htf) + ')'

        if not na(candleSet.tfTimerTop)
            candleSet.tfTimerTop.set_text(tmr)

        if not na(candleSet.tfTimerBottom)
            candleSet.tfTimerBottom.set_text(tmr)
    candleSet

hcLabel(label lb, x, y, txt, tc, st, sz) =>
    label r = lb
    if na(r)
        r := label.new(x, y, txt, color = color_transparent, textcolor = tc, style = st, size = sz)
    else
        r.set_xy(x, y)
    r

method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()

    if size > 0
        for i = size - 1 to 0
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (hcs.width + hcs.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + hcs.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + hcs.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + hcs.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + hcs.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + hcs.width / 2 + t_buffer)

            if hcs.daily_name //and candleSet.settings.htf == '1D'
                if not na(candle.dow_label)
                    candle.dow_label.set_y(candle.h)
                    candle.dow_label.set_x(bar_index + hcs.width / 2 + t_buffer)
                    candle.dow_label.set_text(candle.dow)
                else
                    candle.dow_label := label.new(bar_index + hcs.width / 2 + t_buffer, candle.h, candle.dow, color = color_transparent, textcolor = hcs.dow_color, style = label.style_label_down, size = hcs.dow_size)

    top = 0.0
    bottom = 0.0

    if hcs.label_alignment == 'Align'
        top := hch.CandlesHigh(candleSet.candles)
        bottom := hch.CandlesLow(candleSet.candles, top)
    if hcs.label_alignment == 'Follow Candles'
        top := hch.CandleSetHigh(candleSet.candles, 0)
        bottom := hch.CandleSetLow(candleSet.candles, top)

    left = bar_index + offset + (hcs.width + hcs.buffer) * (size - 1) / 2

    if hcs.htf_label_show
        string lblt = hch.HTFName(candleSet.settings.htf)
        string lbll = lblt
        if hcs.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
        if hcs.daily_name
            lblt := lblt + '\n'

        string tmr = '(' + hch.RemainingTime(candleSet.settings.htf) + ')' + (hcs.daily_name ? '\n' : '')
        if hcs.label_position == 'Both' or hcs.label_position == 'Top'
            candleSet.tfNameTop := hcLabel(candleSet.tfNameTop, left, top, lblt, hcs.htf_label_color, label.style_label_down, hcs.htf_label_size)
            if hcs.htf_timer_show
                candleSet.tfTimerTop := hcLabel(candleSet.tfTimerTop, left, top, tmr, hcs.htf_timer_color, label.style_label_down, hcs.htf_timer_size)

        if hcs.label_position == 'Both' or hcs.label_position == 'Bottom'
            candleSet.tfNameBottom := hcLabel(candleSet.tfNameBottom, left, bottom, lbll, hcs.htf_label_color, label.style_label_up, hcs.htf_label_size)
            if hcs.htf_timer_show
                candleSet.tfTimerBottom := hcLabel(candleSet.tfTimerBottom, left, bottom, tmr, hcs.htf_timer_color, label.style_label_up, hcs.htf_timer_size)

    candleSet

method HCFindImbalance(CandleSet candleSet) =>
    if barstate.isrealtime or barstate.islast
        if candleSet.imbalances.size() > 0
            for i = candleSet.imbalances.size() - 1 to 0
                HCImbalance del = candleSet.imbalances.get(i)
                box.delete(del.b)
                candleSet.imbalances.pop()

        if candleSet.candles.size() > 3 and hcs.fvg_show
            for i = 0 to candleSet.candles.size() - 3 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 2)
                candle3 = candleSet.candles.get(i + 1)

                if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    HCImbalance imb = HCImbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), candle2.h, box.get_right(candle1.body), candle1.l, bgcolor = hcs.fvg_color, border_color = color_transparent, xloc = xloc.bar_index)
                    candleSet.imbalances.push(imb)
                if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    HCImbalance imb = HCImbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), candle1.h, box.get_left(candle2.body), candle2.l, bgcolor = hcs.fvg_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                box temp = box.copy(candle3.body)
                box.delete(candle3.body)
                candle3.body := temp
                candle3.body

        if candleSet.candles.size() > 2 and hcs.vi_show
            for i = 0 to candleSet.candles.size() - 2 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 1)
                if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    HCImbalance imb = HCImbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), math.min(candle1.o, candle1.c), box.get_right(candle1.body), math.max(candle2.o, candle2.c), bgcolor = hcs.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    HCImbalance imb = HCImbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), math.min(candle2.o, candle2.c), box.get_left(candle2.body), math.max(candle1.o, candle1.c), bgcolor = hcs.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
    candleSet

hc_in830 = not na(time(timeframe.period, "0830-0831:123456", 'America/New_York'))
hc_in930 = not na(time(timeframe.period, "0930-0931:123456", 'America/New_York'))
hc_new830 = hc_in830 and not hc_in830[1]
hc_new930 = hc_in930 and not hc_in930[1]
hc_newMidnight = dayofweek(time, 'America/New_York') != dayofweek(time[1], 'America/New_York')

method Monitor(CandleSet candleSet) =>
    int HTFBarTime = time(candleSet.settings.htf, 'America/New_York')
    bool isNewHTFCandle = not na(candleSet.htfTime) and HTFBarTime > candleSet.htfTime
    candleSet.htfTime := na(HTFBarTime) ? candleSet.htfTime : HTFBarTime

    if hcs.use_custom_daily and candleSet.settings.htf == '1D'
        isNewHTFCandle := hcs.custom_daily == 'Midnight' ? hc_newMidnight : hcs.custom_daily == '8:30' ? hc_new830 : hc_new930
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        float htfNum = str.tonumber(candleSet.settings.htf)
        candle.dow := candleSet.settings.htf == '1D' ? hch.DayofWeek(dayofweek(time_tradingday, "America/New_York")) : htfNum < 60 ? str.format_time(candle.o_time, 'm', 'America/New_York') : htfNum >= 60 ? str.format_time(candle.o_time, 'H', 'America/New_York') : candleSet.settings.htf == '1M' ? str.format_time(candle.o_time, 'M', 'America/New_York') : ''
        bull = candle.c > candle.o

        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? hcs.bull_border : hcs.bear_border, 1, bgcolor = bull ? hcs.bull_body : hcs.bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = bull ? hcs.bull_wick : hcs.bear_wick)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = bull ? hcs.bull_wick : hcs.bear_wick)

        candleSet.candles.unshift(candle)

        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            delCandle.dow_label.delete()

    candleSet

hcTraceLine(line ln, label lb, int x1, float y, int x2, color col, string sty, int wd, int lblX) =>
    line l = ln
    label lab = lb
    if na(l)
        l := line.new(x1, y, x2, y, xloc = xloc.bar_index, color = col, style = hch.HCLineStyle(sty), width = wd)
    else
        line.set_xy1(l, x1, y)
        line.set_xy2(l, x2, y)
    if hcs.label_show
        if na(lab)
            lab := label.new(lblX, y, str.tostring(y), textalign = text.align_center, style = label.style_label_left, size = hcs.label_size, color = color_transparent, textcolor = hcs.label_color)
        else
            label.set_xy(lab, lblX, y)
            label.set_text(lab, str.tostring(y))
    [l, lab]

method Update(CandleSet candleSet, int offset, bool showTrace) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index

        bull = candle.c > candle.o

        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_bgcolor(candle.body, bull ? hcs.bull_body : hcs.bear_body)
        box.set_border_color(candle.body, bull ? hcs.bull_border : hcs.bear_border)
        line.set_color(candle.wick_up, bull ? hcs.bull_wick : hcs.bear_wick)
        line.set_color(candle.wick_down, bull ? hcs.bull_wick : hcs.bear_wick)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        if barstate.isrealtime or barstate.islast
            candleSet.Reorder(offset)
            if hcs.trace_show and showTrace
                int lblX = box.get_right(candle.body)
                int bodyL = box.get_left(candle.body)
                if bar_index - candle.o_idx < 5000
                    [lnO, lbO] = hcTraceLine(trace.o, trace.o_l, candle.o_idx, candle.o, bodyL, hcs.trace_o_color, hcs.trace_o_style, hcs.trace_o_size, lblX)
                    trace.o := lnO
                    trace.o_l := lbO
                if bar_index - candle.c_idx < 5000
                    [lnC, lbC] = hcTraceLine(trace.c, trace.c_l, candle.c_idx, candle.c, bodyL, hcs.trace_c_color, hcs.trace_c_style, hcs.trace_c_size, lblX)
                    trace.c := lnC
                    trace.c_l := lbC
                if bar_index - candle.h_idx < 5000
                    [lnH, lbH] = hcTraceLine(trace.h, trace.h_l, candle.h_idx, candle.h, line.get_x1(candle.wick_up), hcs.trace_h_color, hcs.trace_h_style, hcs.trace_h_size, lblX)
                    trace.h := lnH
                    trace.h_l := lbH
                if bar_index - candle.l_idx < 5000
                    [lnL, lbL] = hcTraceLine(trace.l, trace.l_l, candle.l_idx, candle.l, line.get_x1(candle.wick_down), hcs.trace_l_color, hcs.trace_l_style, hcs.trace_l_size, lblX)
                    trace.l := lnL
                    trace.l_l := lbL
    candleSet

int cnt = 0
int last = hch.HTFEnabled()

int offset = hcs.offset
for i = 0 to hc_sets.size() - 1
    CandleSet cs = hc_sets.get(i)
    if cs.settings.show and hch.ValidTimeframe(cs.settings.htf) and cnt < last
        bool showTrace = (hcs.trace_anchor == 'First Timeframe' and cnt == 0) or (hcs.trace_anchor == 'Last Timeframe' and cnt == last - 1)
        cs.UpdateTime(offset)
        cs.Monitor().Update(offset, showTrace).HCFindImbalance()
        cnt += 1
        offset += cs.candles.size() * hcs.width + (cs.candles.size() > 0 ? (cs.candles.size() - 1) * hcs.buffer : 0) + hcs.htf_buffer
